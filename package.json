    "viewsWelcome": [
      {
        "view": "cInsight.context",
        "contents": "Open a C or C++ file to inspect the symbol under the cursor.\n[Restart clangd](command:cInsight.restartClangd)"
      },
      {
        "view": "cInsight.symbols",
        "contents": "[Search workspace symbols](command:cInsight.searchSymbols)"
      },
      {
        "view": "cInsight.workspaceSymbols",
        "contents": "[Search workspace symbols](command:cInsight.searchSymbols)"
      },
      {
        "view": "cInsight.includes",
        "contents": "Place the cursor in a C/C++ file, then [show its include hierarchy](command:cInsight.includeHierarchy.showIncludes)."
      },
      {
        "view": "cInsight.includedBy",
        "contents": "Place the cursor in a C/C++ file, then [find files that include it](command:cInsight.includeHierarchy.showIncludedBy)."
      }
    ],
    "configuration": {
      "title": "C Insight",
      "properties": {
        "cInsight.clangd.path": {
          "type": "string",
          "default": "",
          "description": "Path to the clangd executable. Empty uses PATH."
        },
        "cInsight.clangd.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to clangd."
        },
        "cInsight.clangd.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "verbose"
          ],
          "default": "info"
        },
        "cInsight.compileCommandsDir": {
          "type": "string",
          "default": "",
          "description": "Directory containing compile_commands.json. Empty automatically searches the workspace root and common build directories."
        },
        "cInsight.fallbackFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-std=c++17"
          ]
        },
        "cInsight.backgroundIndex": {
          "type": "boolean",
          "default": true
        },
        "cInsight.followCursor": {
          "type": "boolean",
          "default": true
        },
        "cInsight.followCursorDelay": {
          "type": "number",
          "default": 200,
          "minimum": 50,
          "maximum": 2000
        },
        "cInsight.followCursorDetailsDelay": {
          "type": "number",
          "default": 600,
          "minimum": 200,
          "maximum": 5000,
          "description": "Additional idle delay before loading references and first-level caller/callee counts."
        },
        "cInsight.codePreview.linesBefore": {
          "type": "number",
          "default": 6,
          "minimum": 0,
          "maximum": 100,
          "description": "Number of source lines displayed before the Code Preview target."
        },
        "cInsight.codePreview.linesAfter": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 100,
          "description": "Number of source lines displayed after the Code Preview target."
        },
        "cInsight.references.pageSize": {
          "type": "number",
          "default": 200,
          "minimum": 25,
          "maximum": 5000,
          "description": "Number of reference results added to the tree per page."
        },
        "cInsight.references.groupBy": {
          "type": "string",
          "enum": [
            "file",
            "directory",
            "function",
            "type",
            "flat"
          ],
          "default": "file",
          "description": "Persisted grouping mode for the References view."
        },
        "cInsight.history.maximumEntries": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 2000,
          "description": "Maximum number of navigation history entries retained for the current VS Code session."
        },
        "cInsight.history.mergeConsecutiveDuplicates": {
          "type": "boolean",
          "default": true,
          "description": "Merge consecutive navigation entries with the same location, mode, and origin."
        },
        "cInsight.symbolSearch.groupBy": {
          "type": "string",
          "enum": [
            "type",
            "file",
            "directory",
            "flat"
          ],
          "default": "type",
          "description": "Persisted grouping mode for the Symbol Search view."
        },
        "cInsight.bookmarks.sortBy": {
          "type": "string",
          "enum": [
            "name",
            "path",
            "position",
            "created",
            "updated"
          ],
          "default": "updated",
          "description": "Persisted sorting mode for bookmarks within each group."
        },
        "cInsight.session.restore": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save and restore C Insight browsing state for the current folder or multi-root workspace."
        },
        "cInsight.session.persistNavigationHistory": {
          "type": "boolean",
          "default": true,
          "description": "Include Navigation History in the workspace session snapshot."
        },
        "cInsight.session.restoreCallHierarchy": {
          "type": "boolean",
          "default": true,
          "description": "Re-query and restore the previous Callers/Callees root and loaded depth."
        },
        "cInsight.session.maximumAgeDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 365,
          "description": "Ignore saved workspace sessions older than this many days."
        },
        "cInsight.typeHierarchy.defaultDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "description": "Type hierarchy depth loaded automatically for a new root. Zero keeps roots collapsed."
        },
        "cInsight.typeHierarchy.maximumDepth": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum depth allowed for type hierarchy expansion."
        },
        "cInsight.typeHierarchy.maximumNodes": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 50000,
          "description": "Maximum number of nodes loaded independently in each Supertypes or Subtypes tree."
        },
        "cInsight.includeHierarchy.defaultDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "description": "Include hierarchy depth loaded automatically for a new root. Zero keeps roots collapsed."
        },
        "cInsight.includeHierarchy.maximumDepth": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum depth allowed for include hierarchy expansion."
        },
        "cInsight.includeHierarchy.maximumNodes": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 50000,
          "description": "Maximum number of include hierarchy nodes loaded for the current root."
        },
        "cInsight.includeHierarchy.includeSystemHeaders": {
          "type": "boolean",
          "default": false,
          "description": "Resolve and expand system headers in include hierarchies. Disabled by default to avoid very large trees."
        },
        "cInsight.includeHierarchy.workspaceFileLimit": {
          "type": "number",
          "default": 20000,
          "minimum": 100,
          "maximum": 200000,
          "description": "Maximum workspace source/header files scanned when building the on-demand Included By index."
        },
        "cInsight.symbolSearch.maximumResults": {
          "type": "number",
          "default": 500,
          "minimum": 25,
          "maximum": 5000,
          "description": "Maximum workspace symbol results displayed per query."
        },
        "cInsight.symbolSearch.debounce": {
          "type": "number",
          "default": 250,
          "minimum": 100,
          "maximum": 2000,
          "description": "Delay in milliseconds before sending a workspace symbol query while typing."
        },
        "cInsight.callHierarchy.defaultDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "description": "Call hierarchy depth expanded automatically for a new root. Zero keeps roots collapsed."
        },
        "cInsight.callHierarchy.maximumDepth": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum depth allowed for manual or automatic call hierarchy expansion."
        },
        "cInsight.callHierarchy.maximumNodes": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 50000,
          "description": "Maximum number of nodes created independently in each Callers or Callees tree."
        },
        "cInsight.callHierarchy.cacheSize": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "maximum": 10000,
          "description": "Maximum cached Incoming/Outgoing function requests."
        },
        "cInsight.callHierarchy.pathSearchMaximumDepth": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum edge depth explored by caller/callee path search."
        },
        "cInsight.callHierarchy.pathSearchMaximumPaths": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum matching call paths returned by one search."
        },
        "cInsight.callHierarchy.pathSearchMaximumNodes": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 50000,
          "description": "Maximum semantic nodes visited by one call path search."
        },
        "cInsight.includeDeclarationInReferences": {
          "type": "boolean",
          "default": true
        },
        "cInsight.includeSystemReferences": {
          "type": "boolean",
          "default": false
        },
        "cInsight.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "/build/",
            "/generated/",
            "/third_party/"
          ],
          "description": "Path fragments excluded from C Insight result views."
        }
      }
    }
  }
}
