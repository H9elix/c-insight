        "icon": "$(search)"
      },
      {
        "command": "cInsight.callers.exportText",
        "title": "C Insight: Export Callers as Text"
      },
      {
        "command": "cInsight.callers.exportJson",
        "title": "C Insight: Export Callers as JSON"
      },
      {
        "command": "cInsight.callees.exportText",
        "title": "C Insight: Export Callees as Text"
      },
      {
        "command": "cInsight.callees.exportJson",
        "title": "C Insight: Export Callees as JSON"
      },
      {
        "command": "cInsight.callers.findPath",
        "title": "C Insight: Find Caller Path",
        "icon": "$(git-compare)"
      },
      {
        "command": "cInsight.callees.findPath",
        "title": "C Insight: Find Callee Path",
        "icon": "$(git-compare)"
      },
      {
        "command": "cInsight.callers.exportMermaid",
        "title": "C Insight: Export Callers as Mermaid"
      },
      {
        "command": "cInsight.callees.exportMermaid",
        "title": "C Insight: Export Callees as Mermaid"
      },
      {
        "command": "cInsight.typeHierarchy.showSupertypes",
        "title": "C Insight: Show Supertypes",
        "icon": "$(type-hierarchy-super)"
      },
      {
        "command": "cInsight.typeHierarchy.showSubtypes",
        "title": "C Insight: Show Subtypes",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "cInsight.supertypes.expandToDepth",
        "title": "C Insight: Expand Supertypes to Depth",
        "icon": "$(expand-all)"
      },
      {
        "command": "cInsight.subtypes.expandToDepth",
        "title": "C Insight: Expand Subtypes to Depth",
        "icon": "$(expand-all)"
      },
      {
        "command": "cInsight.typeHierarchy.stopExpansion",
        "title": "C Insight: Stop Type Hierarchy Expansion",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cInsight.supertypes.search",
        "title": "C Insight: Search Loaded Supertypes",
        "icon": "$(search)"
      },
      {
        "command": "cInsight.subtypes.search",
        "title": "C Insight: Search Loaded Subtypes",
        "icon": "$(search)"
      },
      {
        "command": "cInsight.supertypes.exportText",
        "title": "C Insight: Export Supertypes as Text"
      },
      {
        "command": "cInsight.supertypes.exportJson",
        "title": "C Insight: Export Supertypes as JSON"
      },
      {
        "command": "cInsight.supertypes.exportMermaid",
        "title": "C Insight: Export Supertypes as Mermaid"
      },
      {
        "command": "cInsight.subtypes.exportText",
        "title": "C Insight: Export Subtypes as Text"
      },
      {
        "command": "cInsight.subtypes.exportJson",
        "title": "C Insight: Export Subtypes as JSON"
      },
      {
        "command": "cInsight.subtypes.exportMermaid",
        "title": "C Insight: Export Subtypes as Mermaid"
      },
      {
        "command": "cInsight.includeHierarchy.showIncludes",
        "title": "C Insight: Show Includes",
        "icon": "$(references)"
      },
      {
        "command": "cInsight.includeHierarchy.showIncludedBy",
        "title": "C Insight: Show Included By",
        "icon": "$(references)"
      },
      {
        "command": "cInsight.includes.expandToDepth",
        "title": "C Insight: Expand Includes to Depth",
        "icon": "$(expand-all)"
      },
      {
        "command": "cInsight.includedBy.expandToDepth",
        "title": "C Insight: Expand Included By to Depth",
        "icon": "$(expand-all)"
      },
      {
        "command": "cInsight.includes.stopExpansion",
        "title": "C Insight: Stop Includes Expansion",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cInsight.includedBy.stopExpansion",
        "title": "C Insight: Stop Included By Expansion",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cInsight.includes.search",
        "title": "C Insight: Search Loaded Includes",
        "icon": "$(search)"
      },
      {
        "command": "cInsight.includedBy.search",
        "title": "C Insight: Search Loaded Included By",
        "icon": "$(search)"
      },
      {
        "command": "cInsight.includes.exportText",
        "title": "C Insight: Export Includes as Text"
      },
      {
        "command": "cInsight.includes.exportJson",
        "title": "C Insight: Export Includes as JSON"
      },
      {
        "command": "cInsight.includes.exportMermaid",
        "title": "C Insight: Export Includes as Mermaid"
      },
      {
        "command": "cInsight.includedBy.exportText",
        "title": "C Insight: Export Included By as Text"
      },
      {
        "command": "cInsight.includedBy.exportJson",
        "title": "C Insight: Export Included By as JSON"
      },
      {
        "command": "cInsight.includedBy.exportMermaid",
        "title": "C Insight: Export Included By as Mermaid"
