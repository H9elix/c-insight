      },
      {
        "command": "cInsight.references.openList",
        "title": "C Insight: Open Reference List in Editor"
      },
      {
        "command": "cInsight.references.expandAll",
        "title": "C Insight: Expand All Reference Groups"
      },
      {
        "command": "cInsight.references.collapseAll",
        "title": "C Insight: Collapse All Reference Groups"
      },
      {
        "command": "cInsight.callers.expandToDepth",
        "title": "C Insight: Expand Callers to Depth",
