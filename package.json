    "viewsContainers": {
      "activitybar": [
        {
          "id": "cInsight",
          "title": "C Insight",
          "icon": "media/c-insight.svg"
        }
      ]
    },
    "views": {
      "cInsight": [
        {
          "id": "cInsight.context",
          "name": "Context"
        },
        {
          "id": "cInsight.preview",
          "name": "Code Preview",
          "type": "webview"
        },
        {
          "id": "cInsight.references",
          "name": "References"
        },
        {
          "id": "cInsight.callers",
          "name": "Callers"
        },
