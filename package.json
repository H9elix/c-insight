      },
      {
        "command": "cInsight.bookmarks.add",
        "title": "C Insight: Add Bookmark"
      },
      {
        "command": "cInsight.bookmarks.rename",
        "title": "C Insight: Rename Bookmark"
      },
      {
        "command": "cInsight.bookmarks.changeGroup",
        "title": "C Insight: Change Bookmark Group"
      },
      {
        "command": "cInsight.bookmarks.delete",
        "title": "C Insight: Delete Bookmark"
      },
      {
        "command": "cInsight.bookmarks.refresh",
        "title": "C Insight: Refresh Bookmarks",
        "icon": "$(refresh)"
      },
      {
        "command": "cInsight.bookmarks.search",
        "title": "C Insight: Filter Bookmarks",
        "icon": "$(search)"
