      "view/item/context": [
        {
          "command": "cInsight.openLocation",
          "when": "viewItem == location || viewItem == referenceLocation || viewItem == historyLocation || viewItem == bookmarkLocation || viewItem == workspaceSymbolLocation || viewItem == typeHierarchyLocation || viewItem == includeHierarchyLocation || viewItem == unresolvedIncludeLocation",
          "group": "navigation@1"
        },
        {
          "command": "cInsight.references.copy",
          "when": "viewItem == referenceLocation",
          "group": "navigation@2"
        },
        {
          "command": "cInsight.bookmarks.add",
          "when": "viewItem == location || viewItem == referenceLocation || viewItem == historyLocation || viewItem == workspaceSymbolLocation || viewItem == typeHierarchyLocation || viewItem == includeHierarchyLocation",
          "group": "cInsight@1"
        },
        {
          "command": "cInsight.bookmarks.rename",
          "when": "viewItem == bookmarkLocation",
          "group": "cInsight@1"
